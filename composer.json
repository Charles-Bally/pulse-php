{
    "name": "pulse-si/php",
    "description": "Cœur commun des paquets PHP de Pulse : rapports, sondes, tâches planifiées, journaux et mode sécurisé.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://pulse-app.si",
    "keywords": [
        "monitoring",
        "pulse",
        "healthcheck"
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "monolog/monolog": "^3.0",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-curl": "envoi des rapports (repli sur les flux de PHP sans elle)",
        "ext-sodium": "mode sécurisé (PULSE_PUBLIC_KEY)",
        "ext-openssl": "mode sécurisé et épinglage d'un relais (PULSE_RELAY_FINGERPRINT)",
        "ext-pcntl": "arrêt propre du worker et délai strict des sondes",
        "monolog/monolog": "recopie des journaux vers Pulse (SpoolHandler)"
    },
    "autoload": {
        "psr-4": {
            "Pulse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pulse\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
